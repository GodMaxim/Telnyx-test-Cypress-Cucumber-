{
   "name": "telnyx-cypress-cucumber",
   "version": "1.0.0",
   "scripts": {
      "test": "npx cypress run",
      "report:cucumber": "node generate-report.js"
   },
   "cypress-cucumber-preprocessor": {
      "stepDefinitions": [
         "cypress/support/step_definitions/**/*.{js,ts}"
      ],
      "json": {
         "enabled": true,
         "output": "cypress/results/cucumber-report.json"
      }
   },
   "devDependencies": {
      "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
      "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
      "cypress": "^16.1.0",
      "mochawesome": "^8.1.1",
      "mochawesome-merge": "^5.1.1",
      "mochawesome-report-generator": "^6.3.2",
      "multiple-cucumber-html-reporter": "^4.3.0"
   }
}
